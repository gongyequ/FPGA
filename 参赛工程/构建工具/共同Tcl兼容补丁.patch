diff --git a/kernel/tclapi.cc b/kernel/tclapi.cc
index 47c1303a1..9e1f0c474 100644
--- a/kernel/tclapi.cc
+++ b/kernel/tclapi.cc
@@ -533,6 +533,15 @@ static int tcl_set_param(ClientData, Tcl_Interp *interp, int objc, Tcl_Obj *cons
 
 int yosys_tcl_interp_init(Tcl_Interp *interp)
 {
+#ifdef _WIN32
+	// Shared Windows runtime compatibility fix, applied identically to the
+	// original and optimized builds. Prime Tcl's native filesystem cwd before
+	// its library bootstrap probes init.tcl (official Tcl 8.6.15 API).
+	Tcl_Obj *cwd = Tcl_FSGetCwd(interp);
+	if (cwd == nullptr)
+		log_cmd_error("Tcl working directory initialization failed: %s\n", Tcl_GetStringResult(interp));
+	Tcl_DecrRefCount(cwd);
+#endif
 	if (Tcl_Init(interp)!=TCL_OK)
 		log_warning("Tcl_Init() call failed - %s\n",Tcl_ErrnoMsg(Tcl_GetErrno()));
 	Tcl_CreateCommand(interp, "yosys", tcl_yosys_cmd, NULL, NULL);
