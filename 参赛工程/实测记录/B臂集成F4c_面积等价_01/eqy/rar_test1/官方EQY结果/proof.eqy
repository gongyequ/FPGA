[options]
splitnets off

[gold]
read_rtlil gold.il
opt_clean
setundef -zero -init
prep -top test1

[gate]
read_rtlil gate.il
opt_clean
setundef -zero -init
prep -top test1

[match *]
nodefault
gold-match clock
gold-match reset
gold-match valid
gold-match I0
gold-match I1
gold-match I2
gold-match I3
gold-match I4
gold-match I5
gold-match I6
gold-match I7
gold-match Q0
gold-match Q1
gold-match Q2
gold-match Q3
gold-match Q4
gold-match Q5
gold-match Q6
gold-match Q7
gold-match por6_out
gold-match inter0007_out
gold-match inter0008_out
gold-match inter0009_out

[collect *]
group *

[strategy sat]
use sat
depth 20
